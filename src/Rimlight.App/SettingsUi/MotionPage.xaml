<UserControl x:Class="Rimlight.App.SettingsUi.MotionPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             FontFamily="{DynamicResource ContentControlThemeFontFamily}"
             FontSize="14">
    <UserControl.Resources>
        <ResourceDictionary Source="PageStyles.xaml" />
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource PageScroller}">
        <StackPanel Style="{StaticResource PageContent}">
            <TextBlock Style="{StaticResource PageTitle}" Text="Motion" />

            <Border Style="{StaticResource Row}">
                <StackPanel>
                    <TextBlock Style="{StaticResource RowLabel}" Text="Mode" />
                    <RadioButton x:Name="MusicSyncChoice" GroupName="Mode" Margin="0,8,0,0" Checked="OnModeChanged"
                                 AutomationProperties.Name="Music Sync"
                                 AutomationProperties.HelpText="Brightness and width follow the music, with a pulse on each beat.">
                        <StackPanel>
                            <TextBlock Text="Music Sync" />
                            <TextBlock Style="{StaticResource RowDescription}" Text="Brightness and width follow the music, with a pulse on each beat." />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="IdleGlowChoice" GroupName="Mode" Margin="0,8,0,0" Checked="OnModeChanged"
                                 AutomationProperties.Name="Idle Glow"
                                 AutomationProperties.HelpText="A steady glow that breathes slowly and ignores the sound.">
                        <StackPanel>
                            <TextBlock Text="Idle Glow" />
                            <TextBlock Style="{StaticResource RowDescription}" Text="A steady glow that breathes slowly and ignores the sound." />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="OffChoice" GroupName="Mode" Margin="0,8,0,0" Checked="OnModeChanged"
                                 AutomationProperties.Name="Off"
                                 AutomationProperties.HelpText="No glow, and nothing runs.">
                        <StackPanel>
                            <TextBlock Text="Off" />
                            <TextBlock Style="{StaticResource RowDescription}" Text="No glow, and nothing runs." />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Row}">
                <DockPanel>
                    <ComboBox x:Name="WhenSilentBox" DockPanel.Dock="Right" MinWidth="170" VerticalAlignment="Center" Margin="16,0,0,0"
                              AutomationProperties.Name="When it's quiet" SelectionChanged="OnWhenSilentChanged">
                        <ComboBoxItem Content="Switch to Idle Glow" />
                        <ComboBoxItem Content="Hide the glow" />
                    </ComboBox>
                    <StackPanel>
                        <TextBlock Style="{StaticResource RowLabel}" Text="When it's quiet" />
                        <TextBlock x:Name="WhenSilentDescription" Style="{StaticResource RowDescription}"
                                   Text="After two seconds without sound, in Music Sync." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Row}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock x:Name="SensitivityValue" DockPanel.Dock="Right" Style="{StaticResource ValueText}" />
                        <TextBlock Style="{StaticResource RowLabel}" Text="Sensitivity" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource RowDescription}" Text="How strongly the sound drives the light. Raise it for quiet music." />
                    <Slider x:Name="SensitivitySlider" Margin="0,8,0,0" Minimum="0.25" Maximum="2" SmallChange="0.05" LargeChange="0.25"
                            TickFrequency="0.05" IsSnapToTickEnabled="True" AutomationProperties.Name="Sensitivity"
                            ValueChanged="OnSensitivityChanged" />
                </StackPanel>
            </Border>

            <!-- So users can see that the sound reaches the app (doc 06 §3.3). -->
            <Border Style="{StaticResource Row}">
                <StackPanel>
                    <DockPanel>
                        <Ellipse x:Name="BeatDot" DockPanel.Dock="Right" Width="12" Height="12" Margin="12,0,0,0" Opacity="0.15"
                                 Fill="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource RowLabel}" Text="Sound level" />
                    </DockPanel>
                    <ProgressBar x:Name="LevelMeter" Margin="0,8,0,0" Height="6" Minimum="0" Maximum="100"
                                 AutomationProperties.Name="Sound level" />
                    <TextBlock x:Name="MeterStatus" Style="{StaticResource RowDescription}" Margin="0,6,0,0"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
