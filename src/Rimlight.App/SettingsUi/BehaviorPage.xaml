<UserControl x:Class="Rimlight.App.SettingsUi.BehaviorPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             FontFamily="{DynamicResource ContentControlThemeFontFamily}"
             FontSize="14">
    <UserControl.Resources>
        <ResourceDictionary Source="PageStyles.xaml" />
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource PageScroller}">
        <StackPanel Style="{StaticResource PageContent}">
            <TextBlock Style="{StaticResource PageTitle}" Text="Behavior" />

            <Border Style="{StaticResource Row}">
                <DockPanel>
                    <ui:ToggleSwitch x:Name="FullscreenSwitch" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"
                                     AutomationProperties.Name="Pause in fullscreen apps"
                                     AutomationProperties.HelpText="Games, videos and presentations that fill a screen pause the glow on that screen."
                                     Checked="OnFullscreenChanged" Unchecked="OnFullscreenChanged" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource RowLabel}" Text="Pause in fullscreen apps" />
                        <TextBlock Style="{StaticResource RowDescription}"
                                   Text="Games, videos and presentations that fill a screen pause the glow on that screen." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Row}">
                <DockPanel>
                    <ComboBox x:Name="BatteryBox" DockPanel.Dock="Right" MinWidth="200" VerticalAlignment="Center" Margin="16,0,0,0"
                              AutomationProperties.Name="On battery" SelectionChanged="OnBatteryChanged">
                        <ComboBoxItem Content="Keep going" />
                        <ComboBoxItem Content="Save power (30 fps)" />
                        <ComboBoxItem Content="Pause the glow" />
                    </ComboBox>
                    <StackPanel>
                        <TextBlock Style="{StaticResource RowLabel}" Text="On battery" />
                        <TextBlock Style="{StaticResource RowDescription}" Text="What the glow does while the PC runs on battery." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Row}">
                <DockPanel>
                    <ui:ToggleSwitch x:Name="CaptureSwitch" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"
                                     AutomationProperties.Name="Hide from screen capture"
                                     AutomationProperties.HelpText="Screenshots, recordings and screen sharing won't show the glow."
                                     Checked="OnCaptureChanged" Unchecked="OnCaptureChanged" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource RowLabel}" Text="Hide from screen capture" />
                        <TextBlock Style="{StaticResource RowDescription}" Text="Screenshots, recordings and screen sharing won't show the glow." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Row}">
                <StackPanel>
                    <DockPanel>
                        <ui:ToggleSwitch x:Name="StartupSwitch" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"
                                         AutomationProperties.Name="Start with Windows"
                                         AutomationProperties.HelpText="Starts in the tray when you sign in."
                                         Checked="OnStartupChanged" Unchecked="OnStartupChanged" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Start with Windows" />
                            <TextBlock Style="{StaticResource RowDescription}" Text="Starts in the tray when you sign in." />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock x:Name="StartupWarning" Style="{StaticResource WarningText}" Visibility="Collapsed"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Border>

            <!-- The glow's keyboard shortcut (doc 06 §4, H-009): recorded by pressing it. -->
            <Border Style="{StaticResource Row}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Button x:Name="RecordButton" MinWidth="150" Click="OnRecordClick"
                                    AutomationProperties.Name="Change the shortcut" />
                            <Button x:Name="ClearButton" Content="Remove" Margin="8,0,0,0" Click="OnClearClick"
                                    AutomationProperties.Name="Remove the shortcut" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Glow on/off shortcut" />
                            <TextBlock x:Name="HotkeyText" Style="{StaticResource RowDescription}" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock x:Name="HotkeyWarning" Style="{StaticResource WarningText}" Visibility="Collapsed"
                               AutomationProperties.LiveSetting="Assertive" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Row}">
                <DockPanel>
                    <ui:ToggleSwitch x:Name="UpdateSwitch" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"
                                     AutomationProperties.Name="Update automatically"
                                     AutomationProperties.HelpText="Checks GitHub for a new version twice a day and installs it the next time the app starts."
                                     Checked="OnUpdateChanged" Unchecked="OnUpdateChanged" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource RowLabel}" Text="Update automatically" />
                        <TextBlock Style="{StaticResource RowDescription}"
                                   Text="Checks GitHub for a new version twice a day and installs it the next time the app starts. This is the only thing the app sends over the internet." />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
