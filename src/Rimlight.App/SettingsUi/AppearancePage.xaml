<UserControl x:Class="Rimlight.App.SettingsUi.AppearancePage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             FontFamily="{DynamicResource ContentControlThemeFontFamily}"
             FontSize="14">
    <UserControl.Resources>
        <ResourceDictionary Source="PageStyles.xaml" />
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource PageScroller}">
        <StackPanel Style="{StaticResource PageContent}">
            <TextBlock Style="{StaticResource PageTitle}" Text="Appearance" />

            <!-- A miniature screen with the glow drawn from the current settings and colors (CPU, about 30 fps, only
                 while this page is on screen). -->
            <Border HorizontalAlignment="Center" Background="#FF1C1C24" CornerRadius="10" Padding="7"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid Width="352" Height="198" Background="#FF0A0A0F">
                    <Image x:Name="PreviewImage" Stretch="Fill" RenderOptions.BitmapScalingMode="Linear"
                           AutomationProperties.Name="Preview of the glow" />
                </Grid>
            </Border>
            <TextBlock x:Name="PreviewCaption" Style="{StaticResource RowDescription}" HorizontalAlignment="Center"
                       TextAlignment="Center" Margin="0,8,0,0" />

            <TextBlock Style="{StaticResource SectionHeader}" Text="Shape" />

            <Border Style="{StaticResource Row}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock x:Name="ThicknessValue" DockPanel.Dock="Right" Style="{StaticResource ValueText}" />
                        <TextBlock Style="{StaticResource RowLabel}" Text="Thickness" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource RowDescription}" Text="The solid line along the edges. 0 leaves only the glow." />
                    <Slider x:Name="ThicknessSlider" Margin="0,8,0,0" Minimum="0" Maximum="40" SmallChange="1" LargeChange="5"
                            TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Thickness in pixels"
                            ValueChanged="OnThicknessChanged" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Row}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock x:Name="GlowValue" DockPanel.Dock="Right" Style="{StaticResource ValueText}" />
                        <TextBlock Style="{StaticResource RowLabel}" Text="Glow" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource RowDescription}" Text="How far the light spills inward, from a hairline to about a third of the screen." />
                    <Slider x:Name="GlowSlider" Margin="0,8,0,0" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10"
                            TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Glow in percent"
                            ValueChanged="OnGlowChanged" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Row}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock x:Name="BrightnessValue" DockPanel.Dock="Right" Style="{StaticResource ValueText}" />
                        <TextBlock Style="{StaticResource RowLabel}" Text="Brightness" />
                    </DockPanel>
                    <Slider x:Name="BrightnessSlider" Margin="0,8,0,0" Minimum="10" Maximum="100" SmallChange="1" LargeChange="10"
                            TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Brightness in percent"
                            ValueChanged="OnBrightnessChanged" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Row}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock x:Name="CornerValue" DockPanel.Dock="Right" Style="{StaticResource ValueText}" />
                        <TextBlock Style="{StaticResource RowLabel}" Text="Corner radius" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource RowDescription}" Text="Round the corners to match a screen with rounded corners." />
                    <Slider x:Name="CornerSlider" Margin="0,8,0,0" Minimum="0" Maximum="40" SmallChange="1" LargeChange="5"
                            TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Corner radius in pixels"
                            ValueChanged="OnCornerChanged" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Row}">
                <DockPanel>
                    <ui:ToggleSwitch x:Name="CoverTaskbarSwitch" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"
                                     AutomationProperties.Name="Cover the taskbar"
                                     AutomationProperties.HelpText="Lights the whole screen edge, over the taskbar. Off keeps the glow above it."
                                     Checked="OnCoverTaskbarChanged" Unchecked="OnCoverTaskbarChanged" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource RowLabel}" Text="Cover the taskbar" />
                        <TextBlock Style="{StaticResource RowDescription}" Text="Light the whole screen edge, over the taskbar. Off keeps the glow above it." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel x:Name="PresetsSection">
                <TextBlock Style="{StaticResource SectionHeader}" Text="Presets" />
                <TextBlock Style="{StaticResource RowDescription}" Margin="0,0,0,8"
                           Text="A preset changes the look and uses its own colors. Turn off Override album color on the Color page to go back to album colors." />
                <WrapPanel x:Name="PresetChips" KeyboardNavigation.TabNavigation="Continue" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
