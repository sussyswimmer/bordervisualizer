<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <!-- Rimlight.exe, as the docs and the Velopack packaging expect; the name comes from AppName in Directory.Build.props. -->
    <AssemblyName>$(AppName)</AssemblyName>
    <RootNamespace>Rimlight.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Placeholder until the real icon is generated from assets/icon.svg (C10 / K12). -->
    <ApplicationIcon>Assets\Rimlight.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- Rimlight.ico, and an optional Rimlight-dim.ico that replaces the derived 50 % tray icon (TrayIconImages). -->
    <Resource Include="Assets\*.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Rimlight.Core/Rimlight.Core.csproj" />
    <ProjectReference Include="../Rimlight.Platform/Rimlight.Platform.csproj" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.2" />
  </ItemGroup>
</Project>
