<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <!-- Rimlight.exe, as the docs and the Velopack packaging expect; the name comes from AppName in Directory.Build.props. -->
    <AssemblyName>$(AppName)</AssemblyName>
    <RootNamespace>Rimlight.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Generated from assets/icon.svg and assets/icon-small.svg by build/icons.sh (or icons.ps1); never edit by hand. -->
    <ApplicationIcon>Assets\Rimlight.ico</ApplicationIcon>
    <!-- Program.Main runs Velopack before WPF starts (doc 06 §5), so WPF must not generate a Main of its own. -->
    <StartupObject>Rimlight.App.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <!-- App.xaml is compiled as a page: the same InitializeComponent, but no generated Main. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>
  <ItemGroup>
    <!-- Rimlight.ico, and Rimlight-dim.ico: the same icon at 50 % opacity for the tray while the glow is off (doc 06 §2).
         Both are generated by build/icons.sh (C10). Without the dim file, TrayIconImages derives it from Rimlight.ico. -->
    <Resource Include="Assets\*.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Rimlight.Core/Rimlight.Core.csproj" />
    <ProjectReference Include="../Rimlight.Platform/Rimlight.Platform.csproj" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.2" />
    <!-- Fluent controls, Mica and light/dark themes for the settings window and the tray menu (MIT). -->
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <!-- Install hooks and updates from GitHub Releases (MIT). The same version as vpk, which packs the app (C9). -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <ItemGroup>
    <!-- Rimlight's license and the notices of the libraries it ships (MIT asks for them in every copy), next to
         Rimlight.exe in every build, so also in the installer, the update package and the portable zip (build/pack.ps1
         checks). THIRD-PARTY-NOTICES.txt lists what the packages don't carry themselves; Rimlight.Tests checks that it
         names every PackageReference here and in Rimlight.Platform. -->
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- NuGet copies no license files, so a publish adds the license and notice files of every package and .NET runtime
       pack it ships files from, as licenses/<package>/<version>/<file>. That covers the self-contained .NET and WPF
       runtimes, the System.* libraries and WPF-UI at the exact versions shipped. -->
  <Target Name="PublishPackageLicenses" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_ShippedPackage Include="@(ResolvedFileToPublish->'%(NuGetPackageId)/%(NuGetPackageVersion)'->ToLowerInvariant()->Distinct())"
                       Condition="'%(ResolvedFileToPublish.NuGetPackageId)' != ''" />
      <_ShippedPackageLicense Include="$(NuGetPackageRoot)%(_ShippedPackage.Identity)/LICENSE*;$(NuGetPackageRoot)%(_ShippedPackage.Identity)/*NOTICE*;$(NuGetPackageRoot)%(_ShippedPackage.Identity)/*Notice*"
                              Package="%(_ShippedPackage.Identity)" />
      <ResolvedFileToPublish Include="@(_ShippedPackageLicense->Distinct())" CopyToPublishDirectory="PreserveNewest"
                             RelativePath="licenses/%(_ShippedPackageLicense.Package)/%(_ShippedPackageLicense.Filename)%(_ShippedPackageLicense.Extension)" />
    </ItemGroup>
  </Target>
</Project>
