<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <!-- Rimlight.exe, as the docs and the Velopack packaging expect; the name comes from AppName in Directory.Build.props. -->
    <AssemblyName>$(AppName)</AssemblyName>
    <RootNamespace>Rimlight.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Generated from assets/icon.svg and assets/icon-small.svg by build/icons.sh (or icons.ps1); never edit by hand. -->
    <ApplicationIcon>Assets\Rimlight.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- Rimlight.ico, and Rimlight-dim.ico (the same icon at 50 % opacity, generated by C10) for the tray while the glow is
         off. TrayIconImages falls back to a derived 50 % icon if the dim file is ever missing. -->
    <Resource Include="Assets\*.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Rimlight.Core/Rimlight.Core.csproj" />
    <ProjectReference Include="../Rimlight.Platform/Rimlight.Platform.csproj" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.2" />
    <!-- Fluent controls, Mica and light/dark themes for the settings window and the tray menu (MIT). -->
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>
</Project>
