<Window x:Class="Rimlight.App.Visualizer.DebugVisualizerWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1000"
        Height="720"
        MinWidth="720"
        MinHeight="520"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="12"
        UseLayoutRounding="True"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <!--
        Doc 03 §4. Left: what the analyzer hears (status, spectrum, scrolling plots), drawn into bitmaps about 30 times
        a second while the window is on screen. Right: every AudioTuning field, applied live on the overlay thread.
        Colors around the plots come from WPF-UI's theme brushes, so the window follows Windows' light or dark mode;
        the plots themselves are a dark scope in both.
    -->
    <Window.Resources>
        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="PlotTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,4" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <!-- Legend chips on the plots' dark background, readable in either app theme. -->
        <Style x:Key="Legend" TargetType="Border">
            <Setter Property="Background" Value="#101016" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="8,10,0,4" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <!-- Under the spectrum, on the window's own background. -->
        <Style x:Key="AxisLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <!-- Inside the spectrum, on the plots' dark background. -->
        <Style x:Key="PlotLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#B4B4C0" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <!-- What the analyzer hears. -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1.3*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="SourceText" Grid.Row="0" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="RateText" Grid.Row="1" Style="{StaticResource Secondary}" Margin="0,2,0,0" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                <Ellipse x:Name="BeatLamp" Width="22" Height="22" Fill="#FFB020" Opacity="0.15" VerticalAlignment="Center"
                         AutomationProperties.Name="Beat" />
                <TextBlock x:Name="BpmText" FontSize="22" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"
                           MinWidth="128" />
                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="BeatsText" />
                    <TextBlock x:Name="FeaturesText" Style="{StaticResource Secondary}" />
                </StackPanel>
                <Border x:Name="SilentBadge" Margin="16,0,0,0" Padding="8,2" CornerRadius="4" VerticalAlignment="Center"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                    <TextBlock x:Name="SilentText" />
                </Border>
            </StackPanel>

            <TextBlock x:Name="SpectrumTitle" Grid.Row="3" Style="{StaticResource PlotTitle}" />
            <Grid Grid.Row="4">
                <Border x:Name="SpectrumHost" ClipToBounds="True" Background="#101016">
                    <Image x:Name="SpectrumImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />
                </Border>
                <!-- Band names, placed over their bands in code. -->
                <Canvas x:Name="BandLabels" IsHitTestVisible="False" ClipToBounds="True" />
            </Grid>
            <Canvas x:Name="FrequencyLabels" Grid.Row="5" Height="14" ClipToBounds="True" />

            <StackPanel Grid.Row="6" Orientation="Horizontal">
                <TextBlock x:Name="FeaturesTitle" Style="{StaticResource PlotTitle}" />
                <Border Style="{StaticResource Legend}"><TextBlock Foreground="#A08CFF" FontWeight="SemiBold" Text="Level" /></Border>
                <Border Style="{StaticResource Legend}"><TextBlock Foreground="#22D3EE" FontWeight="SemiBold" Text="Bass" /></Border>
                <Border Style="{StaticResource Legend}"><TextBlock Foreground="#FFB020" FontWeight="SemiBold" Text="Beat" /></Border>
            </StackPanel>
            <Border x:Name="FeaturesHost" Grid.Row="7" ClipToBounds="True" Background="#101016">
                <Image x:Name="FeaturesImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />
            </Border>

            <StackPanel Grid.Row="8" Orientation="Horizontal">
                <TextBlock x:Name="FluxTitle" Style="{StaticResource PlotTitle}" />
                <Border Style="{StaticResource Legend}"><TextBlock Foreground="#E8E8F0" FontWeight="SemiBold" Text="Flux" /></Border>
                <Border Style="{StaticResource Legend}"><TextBlock Foreground="#FF5C7A" FontWeight="SemiBold" Text="Threshold" /></Border>
                <Border Style="{StaticResource Legend}"><TextBlock Foreground="#FFB020" FontWeight="SemiBold" Text="Beats" /></Border>
            </StackPanel>
            <Border x:Name="FluxHost" Grid.Row="9" ClipToBounds="True" Background="#101016">
                <Image x:Name="FluxImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />
            </Border>
        </Grid>

        <!-- Every tuning parameter, then the JSON buttons. -->
        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="Tuning" FontSize="16" FontWeight="SemiBold" />
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Secondary}" Margin="0,2,0,8"
                       Text="Changes apply at once and last until the app exits. Copy them as JSON to keep them; tools/wav-analyze --tuning reads the same JSON." />
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <WrapPanel>
                    <Button x:Name="CopyButton" Content="_Copy params as JSON" Margin="0,0,6,6" Click="OnCopy" />
                    <Button x:Name="PasteButton" Content="_Paste params" Margin="0,0,6,6" Click="OnPaste" />
                    <Button x:Name="ResetButton" Content="_Reset to defaults" Margin="0,0,0,6" Click="OnReset" />
                </WrapPanel>
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" MinHeight="32" />
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel x:Name="TuningRows" Margin="0,0,10,0" />
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
