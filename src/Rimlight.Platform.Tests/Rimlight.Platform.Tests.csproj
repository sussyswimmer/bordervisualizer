<Project Sdk="Microsoft.NET.Sdk">
  <!-- Lane B's tests (K10): the parts of Rimlight.Platform and Rimlight.App that make no Windows calls, run against
       the real Core. A Windows target without WPF, so it builds and runs on Linux too (EnableWindowsTargeting), in
       both CI jobs. App files that use no WPF, WPF-UI or H.NotifyIcon type are compiled in from src/Rimlight.App:
       the app itself is a WPF exe, which a test can't reference. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Rimlight.Platform.Tests</RootNamespace>
    <!-- No background GC in the test host: while one runs (other test classes allocate large arrays in parallel),
         GC.GetAllocatedBytesForCurrentThread can report a few KB on a thread that allocated nothing, which would make
         the zero-allocation tests flaky. Measured: blips in about half the runs with it on, none in six with it off. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Rimlight.Platform/Rimlight.Platform.csproj" />
    <!-- The synthetic test tracks and the reference tuning JSON (H-015). -->
    <ProjectReference Include="../../tools/audio-tools/Rimlight.AudioTools.csproj" />
    <!-- Bench's copies of the frame source and the frame pacer, checked against the app's own. -->
    <ProjectReference Include="../Rimlight.Bench/Rimlight.Bench.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Label="Rimlight.App code without WPF">
    <Compile Include="../Rimlight.App/Overlay/AudioReading.cs" Link="App/Overlay/AudioReading.cs" />
    <Compile Include="../Rimlight.App/Overlay/DemoBeat.cs" Link="App/Overlay/DemoBeat.cs" />
    <Compile Include="../Rimlight.App/Overlay/MusicGlowSource.cs" Link="App/Overlay/MusicGlowSource.cs" />
    <Compile Include="../Rimlight.App/Overlay/SrgbHex.cs" Link="App/Overlay/SrgbHex.cs" />
    <Compile Include="../Rimlight.App/Visualizer/AnalyzerSnapshot.cs" Link="App/Visualizer/AnalyzerSnapshot.cs" />
    <Compile Include="../Rimlight.App/Visualizer/AnalyzerTap.cs" Link="App/Visualizer/AnalyzerTap.cs" />
    <Compile Include="../Rimlight.App/Visualizer/TripleBuffer.cs" Link="App/Visualizer/TripleBuffer.cs" />
    <Compile Include="../Rimlight.App/Visualizer/TuningParameters.cs" Link="App/Visualizer/TuningParameters.cs" />
    <Compile Include="../Rimlight.App/Visualizer/VisualizerFeed.cs" Link="App/Visualizer/VisualizerFeed.cs" />
    <Compile Include="../Rimlight.App/SettingsUi/MonitorChoice.cs" Link="App/SettingsUi/MonitorChoice.cs" />
    <Compile Include="../Rimlight.App/SettingsUi/PresetChoice.cs" Link="App/SettingsUi/PresetChoice.cs" />
    <Compile Include="../Rimlight.App/SettingsUi/ShortcutChoice.cs" Link="App/SettingsUi/ShortcutChoice.cs" />
    <Compile Include="../Rimlight.App/SettingsUi/SrgbColor.cs" Link="App/SettingsUi/SrgbColor.cs" />
    <Compile Include="../Rimlight.App/Updates/UpdateMessages.cs" Link="App/Updates/UpdateMessages.cs" />
    <Compile Include="../Rimlight.App/Updates/UpdateSchedule.cs" Link="App/Updates/UpdateSchedule.cs" />
    <Compile Include="../Rimlight.App/Logging/RollingFileLog.cs" Link="App/Logging/RollingFileLog.cs" />
    <Compile Include="../Rimlight.App/SettingsService.cs" Link="App/SettingsService.cs" />
    <Compile Include="../Rimlight.App/StartupOptions.cs" Link="App/StartupOptions.cs" />
    <Compile Include="../Rimlight.App/TrayToolTip.cs" Link="App/TrayToolTip.cs" />
  </ItemGroup>
</Project>
